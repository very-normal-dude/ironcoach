                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "sets": {
            "items": {
              "$ref": "#/components/schemas/SetCreate"
            },
            "type": "array",
            "minItems": 1,
            "title": "Sets"
          }
        },
        "type": "object",
        "required": [
          "sets"
        ],
        "title": "WorkoutCreate"
      },
      "WorkoutOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
